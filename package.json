{
  "name": "json-http-engine-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript HTTP Engine \u2014 CLI, OAuth host adapters and MCP stdio integration (development)",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check:offline": "npm run typecheck && npm run test",
    "cli": "npm run build && node dist/apps/cli/src/main.js",
    "mcp": "npm run build && node dist/apps/mcp-server/src/main.js",
    "vscode:pack": "npm run build && node tooling/package-vsix.mjs",
    "browser:pack": "npm run build && node tooling/package-browser.mjs",
    "desktop:sidecar": "npm run build && node dist/apps/desktop/src/sidecar.js",
    "desktop:ui:dev": "npm --prefix apps/desktop/ui run dev",
    "desktop:ui:build": "npm --prefix apps/desktop/ui run build",
    "desktop:dev": "npm run build && npm --prefix apps/desktop/ui run dev",
    "desktop:tauri:dev": "npm run build && npm --prefix apps/desktop run dev",
    "desktop:bundle:check": "node tooling/check-desktop-bundle.mjs",
    "desktop:tauri:build": "npm run build && npm run desktop:bundle:check && npm --prefix apps/desktop run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "bin": {
    "json-http": "./dist/apps/cli/src/main.js",
    "json-http-mcp": "./dist/apps/mcp-server/src/main.js"
  }
}

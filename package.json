{
  "name": "json-http-engine-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript HTTP Engine — CLI, OAuth host adapters and MCP stdio integration (development)",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check:offline": "npm run typecheck && npm run test",
    "cli": "npm run build && node dist/apps/cli/src/main.js",
    "mcp": "npm run build && node dist/apps/mcp-server/src/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "bin": {
    "json-http": "./dist/apps/cli/src/main.js",
    "json-http-mcp": "./dist/apps/mcp-server/src/main.js"
  }
}

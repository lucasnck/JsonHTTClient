{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON HTTP Client",
  "version": "0.0.1",
  "identifier": "com.lucasnck.jsonhttclient",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSON HTTP Client",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../../dist/": "dist/",
      "resources/runtime/": "runtime/"
    }
  }
}

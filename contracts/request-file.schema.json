{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.json-http-engine.local/request-file.schema.json",
  "title": "JSON HTTP RequestFile",
  "description": "Associate only with files matching *.request.json. No $format/schemaVersion property.",
  "type": "object",
  "required": [
    "request"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "required": [
        "method",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$",
          "examples": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "{{baseUrl}}/customers"
          ]
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "query": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "none"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "json"
                },
                "value": {}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "text"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "urlencoded"
                },
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "parts"
              ],
              "properties": {
                "type": {
                  "const": "multipart"
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      },
                      "file": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "value"
                        ]
                      },
                      {
                        "required": [
                          "file"
                        ]
                      }
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "const": "binary"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "const": "stream"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "none"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "basic"
                },
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "username",
                "password"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "bearer"
                },
                "token": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "token"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "items"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "inline"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "mode": {
          "const": "sequential"
        },
        "onError": {
          "enum": [
            "stop",
            "continue"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

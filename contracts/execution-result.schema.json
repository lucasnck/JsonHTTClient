{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.json-http-engine.local/execution-result.schema.json",
  "title": "ExecutionResult and ExecutionBatchResult",
  "$defs": {
    "executionResult": {
      "type": "object",
      "required": [
        "request",
        "response",
        "timings"
      ],
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "method",
            "url",
            "headers"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "body": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "none"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "const": "json"
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "const": "urlencoded"
                    },
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "value"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "parts"
                  ],
                  "properties": {
                    "type": {
                      "const": "multipart"
                    },
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          },
                          "file": {
                            "type": "string"
                          }
                        },
                        "oneOf": [
                          {
                            "required": [
                              "value"
                            ]
                          },
                          {
                            "required": [
                              "file"
                            ]
                          }
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "path"
                  ],
                  "properties": {
                    "type": {
                      "const": "binary"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "path"
                  ],
                  "properties": {
                    "type": {
                      "const": "stream"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "response": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "status",
                "statusText",
                "headers",
                "body"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "statusText": {
                  "type": "string"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "body": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "none"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "const": "json"
                        },
                        "value": {}
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "const": "text"
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "artifactRef"
                      ],
                      "properties": {
                        "type": {
                          "const": "binary"
                        },
                        "artifactRef": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "timings": {
          "type": "object",
          "required": [
            "totalMs"
          ],
          "properties": {
            "totalMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "executionBatchResult": {
      "type": "object",
      "required": [
        "summary",
        "timings",
        "results"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "status",
            "total",
            "executed",
            "succeeded",
            "failed",
            "cancelled",
            "skipped"
          ],
          "properties": {
            "status": {
              "enum": [
                "succeeded",
                "partial_failed",
                "failed",
                "cancelled"
              ]
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "executed": {
              "type": "integer",
              "minimum": 0
            },
            "succeeded": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "timings": {
          "type": "object",
          "required": [
            "totalMs"
          ],
          "properties": {
            "totalMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionResult"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/executionResult"
    },
    {
      "$ref": "#/$defs/executionBatchResult"
    }
  ]
}
